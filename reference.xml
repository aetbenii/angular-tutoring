                  <div class="seat"
                       [class.occupied]="isSeatOccupied(seat)"
                       [class.recently-updated]="seatUpdate()?.seatId === seat.id"
                       [class.clickable]="isAdmin() && !isSeatOccupied(seat)"
                       [tabindex]="isAdmin() && !isSeatOccupied(seat) ? 0 : -1"
                       [attr.role]="isAdmin() && !isSeatOccupied(seat) ? 'button' : null"
                       [attr.aria-label]="isAdmin() && !isSeatOccupied(seat) ? 'Assign seat ' + seat.seatNumber : null"
                       (click)="isAdmin() && !isSeatOccupied(seat) ? onSeatClick(seat.id) : undefined"
                       (keydown.enter)="onSeatKeydown($event, seat.id)"
                       (keydown.space)="onSeatKeydown($event, seat.id)">
                    <div class="seat-number">{{seat.seatNumber}}</div>
                  </div>
                }
              </div>
            </div>
          }
        </div>
      }
    </div>
  </div>
  
  <div mat-dialog-actions align="end">
    <button mat-button (click)="onCancel()">Cancel</button>
  </div>
</div>
