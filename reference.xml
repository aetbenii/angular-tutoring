import { Component, inject, OnInit, OnDestroy } from '@angular/core';
import { CommonModule } from '@angular/common';
import { MatToolbarModule } from '@angular/material/toolbar';
import { MatTabsModule } from '@angular/material/tabs';
import { MatButtonModule } from '@angular/material/button';
import { MatIconModule } from '@angular/material/icon';
import { RouterModule } from '@angular/router';
import { Subscription } from 'rxjs';
import { LogoComponent } from '../shared/logo/logo.component';
import { AuthService } from '../../auth/auth.service';
import { isDevelopment } from '../../auth/auth.config';

@Component({
  selector: 'app-header',
  standalone: true,
  imports: [
    CommonModule, 
    MatToolbarModule, 
    MatTabsModule, 
    MatButtonModule,
    MatIconModule,
    RouterModule,
    LogoComponent
  ],
  templateUrl: './header.component.html',
  styleUrls: ['./header.component.scss']
})
export class HeaderComponent implements OnInit, OnDestroy {
  private authService = inject(AuthService);
  private subscription = new Subscription();

  // Authentication state
  isAuthenticated = false;
  userInfo: any = null;
  displayName = '';
  isAdmin = false;

  navLinks = [
    { path: '/dashboard', label: 'Dashboard' },
    { path: '/employees', label: 'Employees' },
    { path: '/offices', label: 'Office assignments' },
    { path: '/floor-plan', label: 'Floor Plan' },
    ...(isDevelopment ? [{ path: '/debug', label: 'Debug' }] : [])
  ];

  async ngOnInit(): Promise<void> {
    // Wait for MSAL initialization
    await this.authService.waitForInitialization();
    
    // Subscribe to authentication status changes
    this.subscription.add(
      this.authService.loginStatus$.subscribe(status => {
        this.isAuthenticated = status;
        if (status) {
          this.userInfo = this.authService.getUserInfo();
          this.displayName = this.getUserDisplayName();
          this.isAdmin = this.checkIsAdmin();
        } else {
          this.userInfo = null;
          this.displayName = '';
          this.isAdmin = false;
        }
      })
    );
  }

  ngOnDestroy(): void {
    this.subscription.unsubscribe();
  }

  private getUserDisplayName(): string {
    if (!this.userInfo) return '';
    
    const claims = this.userInfo.idTokenClaims as any;
    if (claims) {
      if (claims.given_name && claims.family_name) {
        return `${claims.given_name} ${claims.family_name}`;
      }
      if (claims.name) {
        return claims.name;
      }
      if (claims.preferred_username) {
        return claims.preferred_username;
      }
    }
    
    return this.userInfo.username || 'User';
  }

  private checkIsAdmin(): boolean {
    if (!this.userInfo?.idTokenClaims) return false;
    
    const claims = this.userInfo.idTokenClaims as any;
    const roles: string[] = [];
    
    if (claims.roles) {
      roles.push(...claims.roles);
    }
    if (claims.extension_roles) {
      roles.push(...claims.extension_roles);
    }
    
    return roles.includes('app_admin');
  }

  async logout(): Promise<void> {
    try {
      await this.authService.logout();
    } catch (error) {
      console.error('Logout error in header:', error);
    }
  }
}
</file>

