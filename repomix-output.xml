{
    "items": [
        {
            "id": 1,
            "firstName": "John",
            "lastName": "Doe",
            "occupation": "Software Engineer"
        },
        {
            "id": 5,
            "firstName": "Robert",
            "lastName": "Brown",
            "occupation": "DevOps Engineer"
        }
    ],
    "total": 12,
